<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>테이블 5열 고정</title>

<style>
* {
  box-sizing: border-box;
}

body {
  margin: 24px;
  font-family: Arial, sans-serif;
  color: #333;
  background: #f8f9fb;
}

#addButton {
  padding: 9px 16px;
  margin-bottom: 20px;
  border: 1px solid #ddd;
  border-radius: 6px;
  background: #fff;
  color: #333;
  font-size: 14px;
  cursor: pointer;
  transition: background 0.2s;
}

#addButton:hover {
  background: #f0f0f0;
}

#container {
  display: flex;
  flex-direction: column;
  gap: 16px;
  width: 100%;
}

.table-row {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: 12px;
  width: 100%;
}

.table {
  min-width: 0;
  overflow: hidden;
  border: 1px solid #e2e5e9;
  border-radius: 8px;
  background: #fff;
}

.header {
  padding: 12px 6px;
  background: #f1f3f5;
  border-bottom: 1px solid #e2e5e9;
  text-align: center;
  font-size: 14px;
  font-weight: 600;
}

.data-row {
  display: flex;
  border-bottom: 1px solid #f0f1f3;
}

.cell {
  width: 50%;
  min-width: 0;
  padding: 9px 8px;
  border-right: 1px solid #f0f1f3;
  font-size: 13px;
}

.cell:last-child {
  border-right: none;
}

.cell input {
  width: 100%;
  min-width: 0;
  padding: 5px;
  border: 1px solid #e0e3e7;
  border-radius: 4px;
  outline: none;
  font-size: 13px;
}

.cell input:focus {
  border-color: #999;
}

.total {
  padding: 10px 6px;
  background: #fafafa;
  border-bottom: 1px solid #e2e5e9;
  text-align: center;
  font-size: 13px;
  font-weight: 600;
}

.footer {
  padding: 9px 6px;
  background: #fff;
  color: #888;
  text-align: center;
  font-size: 12px;
}
</style>
</head>

<body>

<button id="addButton">+ 추가</button>

<div id="container"></div>

<script>
  const container = document.getElementById("container");
  let nextNumber = 1;

  function createTable() {
    const number = nextNumber++;

    const table = document.createElement("div");
    table.className = "table";

    table.innerHTML = `
      <div class="header">Header ${number}</div>
      <div class="data-rows"></div>
      <div class="total">합계: <span>0</span></div>
    `;

    const dataRows = table.querySelector(".data-rows");

    for (let i = 1; i <= 4; i++) {
      const row = document.createElement("div");
      row.className = "data-row";

      row.innerHTML = `
        <div class="cell">${i}</div>
        <div class="cell">
          <input type="number" value="0">
        </div>
      `;

      row.querySelector("input").addEventListener("input", () => {
        calculateSum(table);
      });

      dataRows.appendChild(row);
    }

    return table;
  }

  function calculateSum(table) {
    let sum = 0;

    table.querySelectorAll("input").forEach(input => {
      sum += Number(input.value) || 0;
    });

    table.querySelector(".total span").textContent = sum;
  }

  function addTableRow() {
    const row = document.createElement("div");
    row.className = "table-row";

    // 한 줄에 테이블을 반드시 5개 생성
    for (let i = 0; i < 5; i++) {
      row.appendChild(createTable());
    }

    container.appendChild(row);
  }

  // 처음에 5개 생성
  addTableRow();

  // 클릭할 때마다 새로운 줄에 5개 추가
  document.getElementById("addButton").addEventListener("click", () => {
    addTableRow();
  });
</script>

</body>
</html>
